# ─── Backend (Express + MongoDB) ─────────────────────────────────────────────
# MongoDB connection string. Override with your own Atlas / local URI.
MONGODB_URI=mongodb://localhost:27017/mrv_codehub

# Port the Express backend listens on (defaults to 3001).
# PORT=3001

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# In production the Express server serves both the API (/api/*) and the
# frontend on the same origin, so VITE_API_BASE_URL is not needed.
# Only uncomment for development if you need a custom API URL:
# VITE_API_BASE_URL=http://localhost:3001/api
